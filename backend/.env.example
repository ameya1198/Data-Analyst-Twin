# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# File Uploads
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=csv,xlsx,xls,json,parquet

# Agent Guardrails
MAX_LLM_CALLS_PER_SESSION=50
MAX_SPECIALIST_CALLS_PER_TURN=15
SPECIALIST_TIMEOUT_SECONDS=60

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/sessions.db
